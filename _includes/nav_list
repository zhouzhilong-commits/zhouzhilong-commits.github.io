{% include base_path %}
{% assign navigation = include.items | default: site.data.navigation[include.nav] %}
{% assign is_root = include.is_root | default: true %}

{% if is_root %}
<nav class="nav__list">
  {% if page.sidebar.title %}<header><h4 class="nav__title" style="padding: 0;">{{ page.sidebar.title }}</h4></header>{% endif %}
{% endif %}

<ul>
  {% for nav in navigation %}
    {% comment %}set "active" class on current page{% endcomment %}
    {% if nav.url and nav.url == page.url %}
      {% assign active = "active" %}
    {% else %}
      {% assign active = "" %}
    {% endif %}

    <li>
      {% if nav.url %}
        {% comment %}internal/external URL check{% endcomment %}
        {% if nav.url contains "://" %}
          {% assign domain = "" %}
        {% else %}
          {% assign domain = base_path %}
        {% endif %}

        <a href="{{ domain }}{{ nav.url }}" class="{{ active }}"><span class="nav__sub-title">{{ nav.title }}</span></a>
      {% else %}
        <span class="nav__sub-title">{{ nav.title }}</span>
      {% endif %}

      {% if nav.children %}
        {% include nav_list items=nav.children is_root=false %}
      {% endif %}
    </li>
  {% endfor %}
</ul>

{% if is_root %}
</nav>
{% endif %}