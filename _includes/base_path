{% comment %}
  For local development we want relative links (avoid jumping to the production domain).
  In production builds we keep absolute links (site.url + baseurl) for canonical/SEO.
{% endcomment %}
{% if jekyll.environment == "development" %}
  {% assign base_path = site.baseurl %}
{% elsif site.url %}
  {% assign base_path = site.url | append: site.baseurl %}
{% else %}
  {% assign base_path = site.github.url %}
{% endif %}